# Supabase Configuration for Theekzu Mobile
# Replace with your actual Supabase URL and Publishable Key from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Server only. Required for rate-limited review submissions. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
REVIEW_RATE_LIMIT_SECRET=
